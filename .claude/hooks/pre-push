#!/usr/bin/env bash
# Tracked source of the common .git/hooks/pre-push symlink (AGENTS.md, Git and
# branches). Allows pushing `main` and tags; refuses every other ref.
# Smoke test:  printf 'refs/heads/factory 0 refs/heads/factory 0\n' | .claude/hooks/pre-push origin x   # exit 1
#              printf 'refs/heads/main 0 refs/heads/main 0\n' | .claude/hooks/pre-push origin x         # exit 0
#              printf 'refs/tags/v0.1.0 0 refs/tags/v0.1.0 0\n' | .claude/hooks/pre-push origin x       # exit 0
while read -r local_ref _ remote_ref _; do
  case "$remote_ref" in
    refs/heads/main | refs/tags/*) ;;
    *)
      echo "pre-push: refusing $local_ref -> $remote_ref. Only 'main' and tags are pushed (AGENTS.md, Git and branches)." >&2
      exit 1
      ;;
  esac
done
exit 0
